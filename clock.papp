{"name":"Playton Clock","icon":"🕰️","html":"<meta charset=\"utf-8\"><style>body{font:system-ui;background:#19263a;color:white;display:grid;place-items:center;height:90vh}h1{font: bold 48px system-ui}small{font:16px system-ui}</style><div><h1 id=\"time\"></h1><small>Playton Corporation</small></div><script>function tick(){document.getElementById('time').textContent=new Date().toLocaleTimeString('ru')}tick();setInterval(tick,1000)</script>"}
